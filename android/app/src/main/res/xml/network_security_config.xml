<?xml version="1.0" encoding="utf-8"?>
<!-- Host network security policy, byte-identical to the Legado fork's
     :app module (legado-engine-src/app/src/main/res/xml/
     network_security_config.xml): base-config permits cleartext so
     book sources whose search/content endpoints are plain http://
     (e.g. SF轻小说 http://s.sfacg.com) work exactly as in Legado.
     Without this, targetSdk defaults reject cleartext with
     "CLEARTEXT communication ... not permitted by network security
     policy" (fix6, device report 2026-11-04). -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration" />

    <debug-overrides cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config>
